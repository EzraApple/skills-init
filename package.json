{
  "name": "skills-init",
  "version": "0.1.1",
  "description": "Bootstrap sensible default agent skills into any repo and wire them across Claude, Cursor, Codex, and OpenCode.",
  "type": "module",
  "bin": {
    "skills-init": "bin/skills-init.js"
  },
  "files": [
    "assets/",
    "bin/",
    "src/",
    "scripts/",
    "skills/",
    "profiles/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EzraApple/skills-init.git"
  },
  "bugs": {
    "url": "https://github.com/EzraApple/skills-init/issues"
  },
  "homepage": "https://github.com/EzraApple/skills-init#readme",
  "scripts": {
    "check": "npm run lint:skills && npm test && npm run pack:dry-run",
    "lint:skills": "node scripts/lint-skills.js",
    "pack:dry-run": "npm pack --dry-run",
    "test": "node --test"
  },
  "keywords": [
    "agents",
    "agent-skills",
    "ai-agents",
    "skills",
    "codex",
    "claude",
    "cursor",
    "opencode",
    "developer-tools",
    "npm-package",
    "scaffold"
  ],
  "author": "Ezra Apple",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
